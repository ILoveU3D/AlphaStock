# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# data/ is regenerable run-time state (snapshots, kline cache) — safe to
# wipe daily
data/
output/

# User territory is LOCAL-ONLY (user mandate 2026-10-03): styles,
# holdings and the session pointer are private — never pushed to any
# remote. Multi-user boundary: shared = code/skills/tower/trading;
# personal = users/.
users/

# Mail territory is LOCAL-ONLY (2026-10-17): SMTP credentials, subscriber
# list and send log are private — never pushed to any remote
mail/

# Company profile assessments are LOCAL-ONLY (user mandate 2026-09-29):
# never pushed to any remote; raw fetches live under the cleanable data/
profiles/

# Financial models are LOCAL-ONLY (2026-10-02 design): assumptions +
# valuation results are proprietary judgment — never pushed to any remote
models/

# Reading library is LOCAL-ONLY (2026-10-10): downloaded master ledgers
# (letters/memos/blog posts) are copyrighted material — never pushed to
# any remote; bricks distilled from them live in tower/ instead
library/

# Skill edit backups (skills.py keeps last 10 versions at runtime)
skills/.backup/

# Tower brick edit backups (tower.py keeps last 10 versions at runtime)
tower/.backup/

# Tooling caches
pipcache/
wheels/
tmp/

# AI workbench scratch (.trae/ loose dumps; documents/model_src stay local)
.trae/

# Misc
*.log
.DS_Store
Thumbs.db

# Session scratch helpers (AGENTS.md: scratch goes to tmp/ or OS temp)
_tmp_*
